# API Keys for Agentic AI Workshop
# Copy this file to .env and insert your real keys for local execution

# Primary Provider: OpenRouter (NVIDIA Nemotron 3.5 Super VL - Free)
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback Provider: Groq (GPT-OSS 120B / Llama 3.3 70B)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
